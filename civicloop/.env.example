# ─────────────────────────────────────────
# CivicLoop Environment Variables
# Copy this file to .env and fill in values
# ─────────────────────────────────────────

# ── Database ──────────────────────────────
DATABASE_URL=postgresql+asyncpg://civicloop:civicloop_secret@localhost:5432/civicloop
SYNC_DATABASE_URL=postgresql://civicloop:civicloop_secret@localhost:5432/civicloop
POSTGRES_USER=civicloop
POSTGRES_PASSWORD=civicloop_secret
POSTGRES_DB=civicloop

# ── JWT ───────────────────────────────────
JWT_SECRET=change_this_to_a_very_long_random_secret_string_at_least_64_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Redis / Celery ────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Google Gemini AI ──────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ── File Uploads ──────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/heic

# ── CORS ──────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── App ───────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
PROJECT_NAME=CivicLoop
API_V1_PREFIX=/api/v1

# ── Email (optional notifications) ────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@civicloop.in

# ── Web Push Notifications ────────────────
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_CLAIM_EMAIL=admin@civicloop.in

# ── Rate Limiting ─────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ── Duplicate Detection ───────────────────
DUPLICATE_RADIUS_METERS=50
DUPLICATE_AUTO_MERGE_THRESHOLD=0.85
DUPLICATE_ASK_THRESHOLD=0.60

# ── SLA Defaults (hours) ─────────────────
SLA_CRITICAL_HOURS=24
SLA_HIGH_HOURS=48
SLA_MEDIUM_HOURS=72
SLA_LOW_HOURS=168

# ── Civic Score ───────────────────────────
CIVIC_SCORE_VERIFIED_REPORT=10
CIVIC_SCORE_CONFIRMATION=5
CIVIC_SCORE_RESOLUTION_VERIFY=10
